<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="224dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/divider_line"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="310dp">

            <ImageView
                android:id="@+id/ivPosterNow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Movie Poster"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_poster_placeholder" />

            <!-- Badge kiri atas -->
            <TextView
                android:id="@+id/tvBadgeNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="10dp"
                android:background="@drawable/bg_chip_selected"
                android:backgroundTint="@color/gold_star"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="SEDANG TAYANG"
                android:textColor="@color/text_primary"
                android:textSize="9sp"
                android:textStyle="bold" />

            <!-- Rating kanan atas -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:background="@drawable/bg_chip_selected"
                android:backgroundTint="#CC1C1917"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="7dp"
                android:paddingVertical="3dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_star"
                    app:tint="@color/gold_star" />

                <TextView
                    android:id="@+id/tvRatingNow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="8.5"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- Bottom CTA bar -->
        <LinearLayout
            android:id="@+id/btnBuyTicketNow"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@color/maroon_dark"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="BELI TIKET"
                android:textColor="@color/gold_star"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
