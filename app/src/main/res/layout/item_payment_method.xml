<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_chip_unselected"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/ivPaymentLogo"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:src="@drawable/ic_pay_bca" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPaymentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OVO"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPaymentMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="E-Wallet • 0812 8899 4566"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivPaymentSelected"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_check_circle"
        android:visibility="gone"
        app:tint="@color/maroon_primary" />
</LinearLayout>
